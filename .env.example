# 서버 주소 (밴드 개발자센터에 등록한 Redirect URI 의 앞부분과 같아야 합니다)
BASE_URL=https://schedule.example.com
PORT=3000

# 네이버 밴드 개발자센터(developers.band.us)에서 앱 등록 후 발급
BAND_CLIENT_ID=
BAND_CLIENT_SECRET=

# (선택) 회사 밴드 멤버만 로그인 허용. 비워 두면 밴드 계정이 있는 누구나 로그인 가능
BAND_KEY=

# 아무 긴 임의 문자열 (로그인 쿠키 서명용)
SESSION_SECRET=

# 데이터 저장 폴더 (기본: ./data)
# DATA_DIR=/data

# ---------- 워크스페이스: 회사 캘린더 ----------
# 밴드 캘린더 "구독 주소" (밴드 앱 > 캘린더 > 설정 > 캘린더 구독(iCal) 에서 복사, webcal://api.band.us/ical?... 형태)
# 이 주소를 아는 사람은 누구나 일정을 볼 수 있으므로 절대 저장소(GitHub)에 올리지 말고 서버 설정에만 넣으세요.
BAND_ICAL_URL=
# (선택) 일정 상세에서 "밴드에서 보기"를 눌렀을 때 열 주소 (예: 회사 밴드 주소)
BAND_URL=

# 인터넷에 공개할 때는 반드시 회사 비밀번호(ACCESS_CODE) 또는 밴드 로그인을 설정하세요.
ACCESS_CODE=
